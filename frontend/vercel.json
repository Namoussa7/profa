{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/profa/browser",
  "rewrites": [{ "source": "/((?!.*\.).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/(ngsw.json|ngsw-worker.js|index.html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)-([A-Z0-9]{8}).(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
