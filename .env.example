POSTGRES_DB=profa
POSTGRES_USER=profa
POSTGRES_PASSWORD=CHANGE_ME_STRONG
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
CORS_ALLOWED_ORIGINS=http://localhost
# Premier compte administrateur (créé au démarrage s'il n'existe pas)
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# Secret partagé envoyé par le fournisseur de paiement dans l'en-tête X-Webhook-Secret
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
# E-mails (mot de passe oublié). Laisser vide pour désactiver ; l'admin peut alors générer des liens à envoyer par WhatsApp.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@profa.ml
# URL publique du frontend (utilisée dans les liens envoyés par e-mail)
APP_FRONTEND_URL=https://profa-frontend-v2.onrender.com
